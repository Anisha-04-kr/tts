PROJECT_NAME="Local AI Voice Assistant"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

HOST="127.0.0.1"
PORT=8000

DEFAULT_ASR_MODEL="whisper-small-local"
DEFAULT_LLM_MODEL="llama3-8b-local"
DEFAULT_TTS_MODEL="fish-speech-s2-pro"

VLLM_OMNI_HOST="127.0.0.1"
VLLM_OMNI_PORT=8002
TTS_ENDPOINT="http://127.0.0.1:8002/v1/audio/speech"
DEFAULT_SPEAKER="default"
VOICE_CLONING_ENABLED=true
LANGUAGE_VALIDATION=false

DEFAULT_SAMPLE_RATE=24000
DEFAULT_CHANNELS=1
DEFAULT_CHUNK_SIZE=1024

ENABLE_GPU=true
CUDA_VISIBLE_DEVICES="0"
DEFAULT_COMPUTE_TYPE="float16"
MAX_VRAM_GB=8.0

LOG_LEVEL="INFO"

LOCAL_WHISPER_ENDPOINT="http://127.0.0.1:8001"
LOCAL_LMSTUDIO_ENDPOINT="http://127.0.0.1:1234/v1"
LOCAL_VLLM_ENDPOINT="http://127.0.0.1:8000/v1"
LOCAL_TTS_ENDPOINT="http://127.0.0.1:8002"
